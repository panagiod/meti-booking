# ============================================
# Meti — Variables de entorno
# Copia este archivo a .env y completa los valores
# ============================================

# --- Base de datos (Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth (better-auth) ---
# Genera un secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# https://console.cloud.google.com/apis/credentials
# URI de redireccion: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Mercado Pago (opcional, solo pagos reales) ---
MERCADOPAGO_ACCESS_TOKEN=""

# --- URL pública de la app (para webhooks de Mercado Pago) ---
# En dev usa un túnel (ngrok/localtunnel) para que MP alcance el webhook.
# Si no se define, se usa BETTER_AUTH_URL.
APP_URL=""

# --- LiveKit Cloud (opcional, solo videollamadas) ---
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""

# --- Grabación de videollamadas (LiveKit Egress → S3) ---
# Necesita la feature Egress habilitada en tu plan de LiveKit Cloud.
# Crea un bucket S3 (o R2 de Cloudflare) con permisos de escritura.
LIVEKIT_EGRESS_S3_BUCKET=""
LIVEKIT_EGRESS_S3_KEY=""
LIVEKIT_EGRESS_S3_SECRET=""
LIVEKIT_EGRESS_S3_REGION="us-east-1"
# Solo si usas S3-compatible (ej. Cloudflare R2): https://...r2.cloudflarestorage.com
LIVEKIT_EGRESS_S3_ENDPOINT=""

# --- Groq (opcional) ---
GROQ_API_KEY=""

# --- Notificaciones por email (Resend) ---
# https://resend.com/api-keys — verifica tu dominio para enviar desde él
RESEND_API_KEY=""
EMAIL_FROM="Meti <notificaciones@cognilab.dev>"

# --- Seguridad (cron) ---
# Secreto que protege el endpoint /api/cron/reminders (genéralo con openssl rand -hex 24)
CRON_SECRET=""

# --- Resend emails ---
RESEND_API_KEY=""

# --- Almacenamiento de archivos (Vercel Blob) ---
# Crea un store en vercel.com/storage y copia el token. Necesario para subir documentos.
BLOB_READ_WRITE_TOKEN=""