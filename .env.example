# ============================================
# MeTi Booking — environment template
# Production (Hetzner lite): use ./deploy/init-env-lite.sh
# Local demo: cp .env.demo.example .env
# ============================================

# SQLite file (local demo or VPS: file:/var/lib/meti-booking/data.db)
DATABASE_URL="file:./data.db"

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-domain.example
NEXT_PUBLIC_BETTER_AUTH_URL=https://your-domain.example

SELF_HOSTED=1
STUDIO_TIMEZONE=Asia/Nicosia
APP_URL=https://your-domain.example

CRON_SECRET=
ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
EMAIL_FROM="MeTi Pilates <bookings@example.com>"
STUDIO_NOTIFICATION_EMAIL=

PAYMENTS_ENABLED=0
MERCADOPAGO_ACCESS_TOKEN=
