# ============================================
# Meti Booking — Environment variables
# Copy this file to .env and fill in the values
# ============================================

# --- Database (Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth (better-auth) ---
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# https://console.cloud.google.com/apis/credentials
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# See deploy/GOOGLE_OAUTH.md for full setup
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: comma-separated extra origins (custom domain + vercel.app during migration)
# BETTER_AUTH_TRUSTED_ORIGINS="https://your-app.vercel.app,https://yourdomain.com"

# --- Mercado Pago (optional, real payments only) ---
# Set PAYMENTS_ENABLED=1 to require Mercado Pago at checkout.
# When unset or 0, bookings are confirmed immediately without online payment.
PAYMENTS_ENABLED="0"
MERCADOPAGO_ACCESS_TOKEN=""

# --- Public app URL (for Mercado Pago webhooks) ---
# In dev, use a tunnel (ngrok/localtunnel) so MP can reach the webhook.
# If not set, BETTER_AUTH_URL is used.
APP_URL=""
# Canonical public site URL (metadata, share links). Defaults to https://metipilates.com
NEXT_PUBLIC_SITE_URL=""

# --- LiveKit Cloud (optional, video calls only) ---
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""

# --- Video call recording (LiveKit Egress → S3) ---
# Requires Egress enabled on your LiveKit Cloud plan.
# Create an S3 bucket (or Cloudflare R2) with write permissions.
LIVEKIT_EGRESS_S3_BUCKET=""
LIVEKIT_EGRESS_S3_KEY=""
LIVEKIT_EGRESS_S3_SECRET=""
LIVEKIT_EGRESS_S3_REGION="us-east-1"
# Only if using S3-compatible storage (e.g. Cloudflare R2): https://...r2.cloudflarestorage.com
LIVEKIT_EGRESS_S3_ENDPOINT=""

# --- Groq (optional) ---
GROQ_API_KEY=""

# --- Email notifications (Resend) ---
# Full setup guide: deploy/RESEND.md
# https://resend.com/api-keys — verify metipilates.com to send from @metipilates.com
RESEND_API_KEY=""
EMAIL_FROM="MeTi Pilates <bookings@metipilates.com>"
# Receives new-booking and reminder emails (defaults to studio contact email in site-config)
STUDIO_NOTIFICATION_EMAIL="tyrri_meropi@hotmail.com"

# --- Security (cron) ---
# Secret that protects the /api/cron/reminders endpoint (generate with openssl rand -hex 24)
CRON_SECRET=""

# --- File storage (Vercel Blob) ---
# Create a store at vercel.com/storage and copy the token. Required for document uploads.
BLOB_READ_WRITE_TOKEN=""

# --- Studio timezone ---
# IANA timezone for slot generation and booking windows (default: Europe/Athens)
STUDIO_TIMEZONE="Europe/Athens"

# --- Encryption (Mercado Pago advisor tokens at rest) ---
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Self-hosted VPS (Hetzner/Docker) ---
# SELF_HOSTED=1
# Enables local disk uploads instead of Vercel Blob

# --- Demo seed (blocked in production unless ALLOW_DEMO_SEED=1) ---
# DEMO_PASSWORD=""
# ALLOW_DEMO_SEED=""
