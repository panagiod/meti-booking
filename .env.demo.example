# ============================================
# Meti Booking — Local demo environment
# Copy to .env: cp .env.demo.example .env
# ============================================

DATABASE_URL="postgresql://meti:meti@localhost:5432/meti_booking?schema=public"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="demo-secret-change-before-production-32chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth is optional for the demo (email/password works).
# Use placeholder values if you are not testing Google login.
GOOGLE_CLIENT_ID="demo-google-client-id"
GOOGLE_CLIENT_SECRET="demo-google-client-secret"

# Cron jobs (optional in local demo)
CRON_SECRET="demo-cron-secret"

# Optional integrations — leave empty for the basic demo
MERCADOPAGO_ACCESS_TOKEN=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""
RESEND_API_KEY=""
BLOB_READ_WRITE_TOKEN=""
GROQ_API_KEY=""
