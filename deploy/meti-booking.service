[Unit]
Description=MeTi Pilates Booking (Next.js lite)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/meti-booking/.next/standalone
EnvironmentFile=/root/meti-booking/.env
Environment=NODE_ENV=production
Environment=HOSTNAME=0.0.0.0
Environment=PORT=3000
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
