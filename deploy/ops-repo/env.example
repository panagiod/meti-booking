# Production variable names only. Real values live in secrets/env.enc
# and on the server at ~/meti-booking/.env (mode 600).

DEPLOY_MODE=lite
DOMAIN=meti-pilates.com
METI_DATA_DIR=/var/lib/meti-booking
DATABASE_URL=file:/var/lib/meti-booking/data.db

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://meti-pilates.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://meti-pilates.com

SELF_HOSTED=1
STUDIO_TIMEZONE=Asia/Nicosia
APP_URL=https://meti-pilates.com

CRON_SECRET=
ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

PAYMENTS_ENABLED=0

RESEND_API_KEY=
EMAIL_FROM=
STUDIO_NOTIFICATION_EMAIL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ADMIN_PROMOTE_TOKEN=
