# Lite production (.env on Hetzner VPS)
# Prefer: FORCE=1 ./deploy/init-env-lite.sh yourdomain.com
# cp deploy/env.production.example .env

DEPLOY_MODE=lite
DOMAIN=meti-pilates.com
METI_DATA_DIR=/var/lib/meti-booking
DATABASE_URL=file:/var/lib/meti-booking/data.db

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://meti-pilates.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://meti-pilates.com

SELF_HOSTED=1
STUDIO_TIMEZONE=Asia/Nicosia
APP_URL=https://meti-pilates.com

CRON_SECRET=
ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
EMAIL_FROM="MeTi Pilates <bookings@meti-pilates.com>"
STUDIO_NOTIFICATION_EMAIL="tyrri_meropi@hotmail.com"

PAYMENTS_ENABLED=0
MERCADOPAGO_ACCESS_TOKEN=

# Demo seed (first deploy only — remove after)
# ALLOW_DEMO_SEED=1
# DEMO_PASSWORD=YourSecurePassword123!
