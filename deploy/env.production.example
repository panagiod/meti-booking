# Copy to project root as .env before deploying on Hetzner VPS
# cp deploy/env.production.example .env

# --- Server ---
DOMAIN=meti-pilates.com
POSTGRES_USER=meti
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=meti_booking

# --- Database (docker internal hostname) ---
DATABASE_URL=postgresql://meti:change-me-strong-password@postgres:5432/meti_booking?schema=public

# --- Auth ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://meti-pilates.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://meti-pilates.com

# --- Self-hosted (enables local disk uploads instead of Vercel Blob) ---
SELF_HOSTED=1

# --- Studio ---
STUDIO_TIMEZONE=Europe/Athens
APP_URL=https://meti-pilates.com

# --- Security ---
CRON_SECRET=
ENCRYPTION_KEY=

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) — see deploy/RESEND.md ---
RESEND_API_KEY=
EMAIL_FROM=MeTi Pilates <bookings@meti-pilates.com>
STUDIO_NOTIFICATION_EMAIL=tyrri_meropi@hotmail.com

# --- Mercado Pago (optional — instructors also connect their own) ---
# PAYMENTS_ENABLED=0 — bookings confirm without online payment (default for now)
PAYMENTS_ENABLED=0
MERCADOPAGO_ACCESS_TOKEN=

# --- Demo seed (first deploy only — remove after) ---
# ALLOW_DEMO_SEED=1
# DEMO_PASSWORD=YourSecurePassword123!
