{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/expire-pending",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/cleanup-cancelled",
      "schedule": "0 3 * * *"
    }
  ]
}
