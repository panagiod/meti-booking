{
  "name": "meti-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/prisma-prepare.mjs && prisma generate --schema .prisma/schema.build.prisma",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/prisma-prepare.mjs && prisma generate --schema .prisma/schema.build.prisma",
    "db:generate": "node scripts/prisma-prepare.mjs && prisma generate --schema .prisma/schema.build.prisma",
    "db:migrate": "node scripts/prisma-prepare.mjs && prisma migrate dev --schema .prisma/schema.build.prisma",
    "db:push": "node scripts/prisma-prepare.mjs && prisma db push --schema .prisma/schema.build.prisma",
    "db:deploy": "node scripts/prisma-prepare.mjs && prisma migrate deploy --schema .prisma/schema.build.prisma",
    "db:clean": "tsx scripts/clean-db.ts",
    "demo:setup": "tsx scripts/demo-setup.ts",
    "demo:start": "docker compose up -d && pnpm demo:setup && pnpm dev",
    "issues:close": "bash scripts/close-resolved-issues.sh",
    "deploy:check": "tsx scripts/deploy-check.ts",
    "deploy:check:hetzner": "tsx scripts/deploy-check-hetzner.ts",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "playwright test -c playwright.production.config.ts",
    "test:setup": "tsx scripts/test-setup.ts",
    "test:cleanup": "tsx scripts/test-cleanup.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.6.27",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "groq-sdk": "^1.5.0",
    "lite-youtube-embed": "^0.3.4",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^1.31.0",
    "mercadopago": "^3.4.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "resend": "^6.20.0",
    "sharp": "^0.35.3",
    "sileo": "^0.1.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.2.2"
}
