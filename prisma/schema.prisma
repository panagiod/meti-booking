// Prisma schema for MeTi Pilates

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTH & USERS (compatible with better-auth)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  admin         AdminProfile?
  instructor    InstructorProfile?
  client        ClientProfile?
  sessions      Session[]
  accounts      Account[]
  appointments  Appointment[] @relation("ClientAppointments")
  blogPosts     BlogPost[]

  @@map("users")
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  CLIENT
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ============================================
// METI CUSTOM MODELS
// ============================================

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  level     String   @default("GESTOR") // "SUPERADMIN" | "GESTOR"
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

// ============================================
// INSTRUCTOR
// ============================================

model InstructorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?  @db.Text
  speciality      String?
  videoUrl        String?
  isActive        Boolean  @default(true)
  isHidden        Boolean  @default(false)

  isVerified          Boolean @default(false)
  verificationStatus  String  @default("NONE")
  verificationNotes   String? @db.Text

  bookingLeadHours Int     @default(2)
  whatsappPhone    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mpMode          String   @default("PRODUCTION")
  mpPublicKey     String?
  mpAccessToken   String?

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  services        InstructorService[]
  schedule        InstructorSchedule[]
  promotions      Promotion[]
  appointments    Appointment[]
  documents       InstructorDocument[]
  invoices        Invoice[]
  categories      InstructorCategory[]
  blockedTimes    BlockedTime[]

  @@map("instructor_profiles")
}

// ============================================
// CATEGORIES
// ============================================

model Category {
  id                String   @id @default(cuid())
  name              String   @unique
  slug              String   @unique
  description       String?  @db.Text
  icon              String?
  color             String?

  minimumPriceCents Int      @default(10000)
  feePercentage     Float    @default(15.0)
  maxFeeCents       Int      @default(100000)

  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  instructors       InstructorCategory[]
  services          InstructorService[]

  @@map("categories")
}

model InstructorCategory {
  id            String   @id @default(cuid())
  instructorId  String
  categoryId    String
  createdAt     DateTime @default(now())

  instructor    InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([instructorId, categoryId])
  @@map("instructor_categories")
}

// ============================================
// BLOCKED TIMES
// ============================================

model BlockedTime {
  id            String   @id @default(cuid())
  instructorId  String
  title         String
  startDate     DateTime
  endDate       DateTime
  isAllDay      Boolean  @default(true)
  reason        String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  instructor    InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId, startDate, endDate])
  @@map("blocked_times")
}

// ============================================
// SERVICES
// ============================================

model InstructorService {
  id                  String   @id @default(cuid())
  instructorId        String
  categoryId          String?
  name                String
  description         String?  @db.Text
  durationMin         Int
  priceCents          Int
  rescheduleHoursMin  Int      @default(24)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  instructor          InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  category            Category?         @relation(fields: [categoryId], references: [id])
  appointments        Appointment[]
  promotions          Promotion[]

  @@map("instructor_services")
}

// ============================================
// SCHEDULE
// ============================================

model InstructorSchedule {
  id            String   @id @default(cuid())
  instructorId  String
  dayOfWeek     Int
  startTime     String
  endTime       String
  lunchStart    String?
  lunchEnd      String?
  gapMinutes    Int      @default(15)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  instructor    InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([instructorId, dayOfWeek])
  @@map("instructor_schedules")
}

// ============================================
// DOCUMENTS
// ============================================

model InstructorDocument {
  id              String    @id @default(cuid())
  instructorId    String
  documentType    String
  fileName        String
  fileUrl         String
  fileSize        Int
  mimeType        String

  aiAnalysis      String?   @db.Text
  aiScore         Float?
  aiStatus        String?

  verifiedBy      String?
  verifiedAt      DateTime?
  manualStatus    String?
  rejectionReason String?   @db.Text

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  instructor      InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@map("instructor_documents")
}

// ============================================
// PROMOTIONS
// ============================================

model Promotion {
  id            String   @id @default(cuid())
  instructorId  String
  serviceId     String
  name          String
  discountType  String
  discountValue Float
  startAt       DateTime
  endAt         DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  instructor    InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  service       InstructorService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("promotions")
}

// ============================================
// INVOICING
// ============================================

enum InvoiceStatus {
  PENDING
  PAID
}

model Invoice {
  id                 String        @id @default(cuid())
  instructorId       String
  periodStart        DateTime
  periodEnd          DateTime
  totalFeeCents      Int
  totalEarningsCents Int
  appointmentCount   Int
  status             InvoiceStatus @default(PENDING)
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  instructor         InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([instructorId, periodStart, periodEnd])
  @@map("invoices")
}

// ============================================
// CLIENT
// ============================================

model ClientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

// ============================================
// APPOINTMENTS
// ============================================

model Appointment {
  id              String            @id @default(cuid())
  clientId        String
  instructorId    String
  serviceId       String
  scheduledAt     DateTime
  durationMin     Int
  status          AppointmentStatus @default(PENDING)

  totalCents         Int
  instructorEarning  Int
  platformFee        Int
  discountCents      Int            @default(0)
  isTest             Boolean        @default(false)
  paymentId          String?
  mpPreferenceId     String?

  liveKitRoomId      String?
  recordingUrl       String?
  recordingEgressId  String?

  transcript         String?        @db.Text
  summary            String?        @db.Text

  cancelReason       String?
  cancelledAt        DateTime?

  reminderSentAt     DateTime?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  client             User               @relation("ClientAppointments", fields: [clientId], references: [id])
  instructor         InstructorProfile  @relation(fields: [instructorId], references: [id])
  service            InstructorService  @relation(fields: [serviceId], references: [id])
  review             Review?
  chatMessages       ChatMessage[]

  @@map("appointments")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ============================================
// REVIEWS
// ============================================

model Review {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  rating        Int
  comment       String?  @db.Text
  createdAt     DateTime @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// ============================================
// PERSISTENT CHAT (video call)
// ============================================

model ChatMessage {
  id            String   @id @default(cuid())
  appointmentId String
  senderId      String
  senderName    String
  senderRole    String
  body          String   @db.Text
  createdAt     DateTime @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("chat_messages")
}

// ============================================
// PLATFORM CONFIG
// ============================================

model PlatformConfig {
  id                String   @id @default(cuid())
  feePercentage     Float    @default(15.0)
  minimumPriceCents Int      @default(10000)
  updatedAt         DateTime @updatedAt

  @@map("platform_configs")
}

// ============================================
// STUDIO CONTENT (MeTi Pilates public site CMS)
// ============================================

model StudioContent {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt

  @@map("studio_content")
}

// ============================================
// BLOG
// ============================================

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  excerpt       String?    @db.Text
  content       String     @db.Text
  coverImage    String?
  authorId      String
  status        BlogStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  author        User       @relation(fields: [authorId], references: [id])

  @@index([status, publishedAt])
  @@map("blog_posts")
}
